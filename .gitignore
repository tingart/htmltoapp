*.aab
*.msi
*.exe
*.AppImage
*.deb
*.dmg

# Keep the source artwork, ignore generated platform icon variants
src-tauri/icons/*.icns
src-tauri/icons/*.ico
src-tauri/icons/32x32.png
src-tauri/icons/128x128.png
src-tauri/icons/128x128@2x.png
src-tauri/icons/android/

# Node and Vite
node_modules/
dist/
build/
*.log
.env.local

# IDE
.vscode/
.idea/
*.iml

# Worker local state and secrets
worker/.wrangler/
worker/.dry-run/
worker/.dev.vars
.dev.vars

# Temporary ZIPs and signing keys
*.zip
*.jks
*.keystore
*.pem
